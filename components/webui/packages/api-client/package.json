{
  "name": "@webui/api-client",
  "version": "0.1.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w --preserveWatchOutput",
    "generate": "openapi-typescript ../../../../docs/src/_static/generated/api-server-openapi.json -o src/schema.ts",
    "lint:check": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint:check --fix"
  },
  "author": "YScope Inc. <dev@yscope.com>",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "eventsource-parser": "^4.0.0",
    "openapi-fetch": "^0.17.0"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.2.9",
    "eslint": "^9.39.4",
    "eslint-config-yscope": "1.1.2",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
